{
  "version": 4,
  "include": ["./ConanPresets.json"],
  "configurePresets": [
    {
      "name": "clang-19-debug",
      "inherits": "conan-clang-19-debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/usr/bin/clang-19",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++-19",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "clang-19-release",
      "inherits": "conan-clang-19-release",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/usr/bin/clang-19",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++-19",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "clang-19-asan",
      "inherits": "conan-clang-19-asan-debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/usr/bin/clang-19",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++-19",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "MATCHING_SANITIZER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "clang-19-ubsan",
      "inherits": "conan-clang-19-ubsan-debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/usr/bin/clang-19",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++-19",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "MATCHING_SANITIZER_FLAGS": "-fsanitize=undefined"
      }
    },
    {
      "name": "clang-19-tsan",
      "inherits": "conan-clang-19-tsan-debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/usr/bin/clang-19",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++-19",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "MATCHING_SANITIZER_FLAGS": "-fsanitize=thread"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "clang-19-debug",
      "configurePreset": "clang-19-debug",
      "inherits": "conan-clang-19-debug",
      "jobs": 8
    },
    {
      "name": "clang-19-release",
      "configurePreset": "clang-19-release",
      "inherits": "conan-clang-19-release",
      "jobs": 8
    },
    {
      "name": "clang-19-asan",
      "configurePreset": "clang-19-asan",
      "inherits": "conan-clang-19-asan-debug",
      "jobs": 8
    },
    {
      "name": "clang-19-ubsan",
      "configurePreset": "clang-19-ubsan",
      "inherits": "conan-clang-19-ubsan-debug",
      "jobs": 8
    },
    {
      "name": "clang-19-tsan",
      "configurePreset": "clang-19-tsan",
      "inherits": "conan-clang-19-tsan-debug",
      "jobs": 8
    }
  ],
  "testPresets": [
    {
      "name": "clang-19-debug",
      "configurePreset": "clang-19-debug",
      "inherits": "conan-clang-19-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang-19-release",
      "configurePreset": "clang-19-release",
      "inherits": "conan-clang-19-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang-19-asan",
      "configurePreset": "clang-19-asan",
      "inherits": "conan-clang-19-asan-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang-19-ubsan",
      "configurePreset": "clang-19-ubsan",
      "inherits": "conan-clang-19-ubsan-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang-19-tsan",
      "configurePreset": "clang-19-tsan",
      "inherits": "conan-clang-19-tsan-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
